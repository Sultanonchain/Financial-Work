{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // The package is run directly by Node's type stripping (node --test *.ts),
    // never compiled to JS. That means relative imports must name the real
    // file on disk ("./types.ts"), and every construct must be erasable:
    // no enums, no namespaces, no parameter properties.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["_shared", "dcf", "catalyst", "news", "redflag", "verdict", "tests"]
}
